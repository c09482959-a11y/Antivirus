{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payload_policy.schema.json",
  "type": "object",
  "required": ["schema_version", "max_candidates", "max_text_bytes", "min_base64_chars", "min_hex_chars", "default_max_depth"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "max_candidates": {"type": "integer", "minimum": 1, "maximum": 256},
    "max_text_bytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
    "min_base64_chars": {"type": "integer", "minimum": 4, "maximum": 4096},
    "min_hex_chars": {"type": "integer", "minimum": 4, "maximum": 4096},
    "default_max_depth": {"type": "integer", "minimum": 1, "maximum": 16}
  }
}
